# DeepSeek API (compatible with OpenAI SDK)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Embedding model (runs locally, no API key needed)
# Options: chinese (default, 95MB, 512d) | english (440MB, 768d) | fast (80MB, 384d) | multilingual (2.2GB, 1024d)
# Or any HuggingFace SentenceTransformer model id
EMBEDDING_MODEL=chinese

# Device override (auto-detected: cuda > mps > cpu)
# EMBEDDING_DEVICE=cuda

# Optional proxy for model downloads or API calls
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
